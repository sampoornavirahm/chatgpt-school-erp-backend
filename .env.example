APP_NAME="School ERP Backend"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SCHOOL_ERP_TRIAL_ENABLED=true
GOOGLE_OAUTH_CLIENT_ID=
SCHOOL_ERP_ACTIVATION_URL=
SCHOOL_ERP_ACTIVATION_SHARED_SECRET=
SCHOOL_ERP_ACTIVATION_DRIVER=dummy
SCHOOL_ERP_ALLOW_DUMMY_ACTIVATIONS=false
API_TOKEN_EXPIRATION_MINUTES=720
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_FILE=
SCHOOL_ERP_PLATFORM_BOOTSTRAP_TOKEN=
SCHOOL_ERP_WEBHOOK_SHARED_SECRET=
SCHOOL_ERP_TRIAL_DAYS=15
SCHOOL_ERP_TRIAL_MAX_DAYS=30
SCHOOL_ERP_OFFLINE_GRACE_DAYS=7
SCHOOL_ERP_LICENSE_ISSUER="School ERP PHP Licensing Service"
SCHOOL_ERP_LICENSE_KEY_ID=production-1
SCHOOL_ERP_LICENSE_PRIVATE_KEY_PATH=/secure/path/outside/public/license-signing.key
SCHOOL_ERP_LICENSE_PUBLIC_KEY_PATH=/secure/path/outside/public/license-public.key
SCHOOL_ERP_LICENSE_AUTO_GENERATE_LOCAL_KEYS=false
SCHOOL_ERP_PAYMENT_DRIVER=dummy
SCHOOL_ERP_ALLOW_DUMMY_PAYMENTS=false
SCHOOL_ERP_MERCHANT_UPI_VPA=
SCHOOL_ERP_MERCHANT_UPI_NAME="School ERP"
